{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://zentari.example/schemas/v1/approval.request.schema.json","title":"approval.request","type":"object","additionalProperties":false,"required":["v","type","approval_id","action","risk","summary","action_digest","nonce","kid","issued_at","expires_at","signature"],"properties":{"v":{"const":1},"type":{"const":"approval.request"},"approval_id":{"type":"string","format":"uuid"},"action":{"type":"string","pattern":"^[a-z0-9._-]{1,47}$"},"risk":{"enum":["destructive","mutating"]},"summary":{"type":"string","minLength":1,"maxLength":159},"action_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{22,48}$"},"kid":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"issued_at":{"type":"integer"},"expires_at":{"type":"integer"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{80,512}$"}}}
