{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://zentari.example/schemas/v1/device.credential.schema.json","title":"device.credential","type":"object","additionalProperties":false,"required":["v","type","device_id","gateway_origin","scope","credential","generation","expires_at"],"properties":{"v":{"const":1},"type":{"const":"device.credential"},"device_id":{"type":"string","pattern":"^[a-z0-9-]{8,64}$"},"gateway_origin":{"type":"string","pattern":"^wss://"},"scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["session:connect","audio:stream","events:receive","approval:respond","ota:read"]}},"credential":{"type":"string","minLength":32,"maxLength":512},"generation":{"type":"integer","minimum":1},"expires_at":{"type":"integer","minimum":1}}}
