{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://zentari.example/schemas/v1/device.command.schema.json","title":"device.command","type":"object","additionalProperties":false,"required":["v","type","command_id","command"],"properties":{"v":{"const":1},"type":{"const":"device.command"},"command_id":{"type":"string","format":"uuid"},"command":{"type":"string","pattern":"^[a-z0-9._-]{1,47}$"},"args":{"type":"object","maxProperties":4},"mutates":{"type":"boolean"},"approval_id":{"type":"string","format":"uuid"},"action":{"type":"string","pattern":"^[a-z0-9._-]{1,47}$"},"risk":{"enum":["mutating"]},"summary":{"type":"string","minLength":1,"maxLength":159},"action_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{22,48}$"},"kid":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"issued_at":{"type":"integer"},"expires_at":{"type":"integer"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{80,512}$"}}}