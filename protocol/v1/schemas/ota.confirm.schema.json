{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://zentari.example/schemas/v1/ota.confirm.schema.json","title":"ota.confirm","type":"object","additionalProperties":false,"required":["v","type","version","result","device_id"],"properties":{"v":{"const":1},"type":{"const":"ota.confirm"},"version":{"type":"string","pattern":"^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$","minLength":5,"maxLength":23},"result":{"enum":["accepted","rejected","rolled_back"]},"device_id":{"type":"string","pattern":"^[a-z0-9-]{8,64}$"},"detail":{"type":"string","minLength":1,"maxLength":64}}}